{
  "id": null,
  "uid": "fitwork-metrics",
  "title": "FitWork - Metrics",
  "description": "API, queues, Gemini, cache, Redis and telemetry health. Business panels show No data until the corresponding activity occurs.",
  "tags": ["fitwork"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^Prometheus$/",
        "hide": 2,
        "refresh": 1,
        "current": {},
        "options": []
      },
      {
        "name": "service",
        "label": "Service",
        "type": "textbox",
        "query": "fitwork-nestjs-api",
        "current": {
          "text": "fitwork-nestjs-api",
          "value": "fitwork-nestjs-api"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests / second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (method, route) (rate(fitwork_http_requests_total{service_name=~\"${service:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP 5xx error ratio",
      "description": "0% means traffic with no 5xx errors. No data means no traffic or missing request metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "(sum(rate(fitwork_http_errors_total{service_name=~\"${service:regex}\",status_class=\"5xx\"}[$__rate_interval])) or vector(0)) / (sum(rate(fitwork_http_requests_total{service_name=~\"${service:regex}\"}[$__rate_interval])) > 0)",
          "legendFormat": "5xx ratio",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP latency p95 / p99",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fitwork_http_request_duration_seconds_bucket{service_name=~\"${service:regex}\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(fitwork_http_request_duration_seconds_bucket{service_name=~\"${service:regex}\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
