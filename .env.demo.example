NODE_ENV=production
DEMO_ENABLED=true
DEMO_ONLY=true
PORT=3000
API_PORT=3010
DATABASE_URL=postgresql://fitwork_demo:change-me@database:5432/fitwork_demo
POSTGRES_USER=fitwork_demo
POSTGRES_DB=fitwork_demo
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379
REDIS_PASSWORD=change-me
CACHE_TTL=300000
JWT_SECRET=replace-with-a-unique-random-demo-secret
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Browser origin served by your HTTPS proxy. API and sockets share that origin.
CORS_ORIGINS=https://demo.example.com
TRUST_PROXY_HOPS=1
OTEL_SDK_DISABLED=true

# Dedicated demo bucket; prepare once with npm run demo:assets.
S3_BUCKET_NAME=fitwork-demo
DEMO_ASSET_BUCKET_CONFIRM=fitwork-demo
S3_API_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: samples work even when live Gemini is not configured.
LLM_EVALUATION_MODEL=
LLM_EVALUATION_KEY=

DEMO_SESSION_MINUTES=60
DEMO_AI_PER_SESSION=3
DEMO_AI_PER_DAY=30
DEMO_AI_PER_IP_DAY=6
DEMO_SESSIONS_PER_IP_HOUR=3
DEMO_MAX_ACTIVE_SESSIONS=20
DEMO_REQUESTS_PER_MINUTE=60
DEMO_UPLOADS_PER_SESSION=3
DEMO_MAX_FILE_BYTES=5242880
DEMO_MAX_RESUME_CHARACTERS=16000
DEMO_MAX_OUTPUT_TOKENS=4096
