{
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "(scripts/perf/.*\\.spec|test/perf\\.e2e-spec)\\.ts$",
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^generated/(.*)$": "<rootDir>/generated/$1",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": { "^.+\\.(t|j)s$": "ts-jest" }
}
