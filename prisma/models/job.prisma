model Job {
  id                   Int            @id @default(autoincrement())
  publicId             String         @unique @default(uuid()) @map("public_id")
  title                String
  description          String
  requirements         String
  location             String
  status               JobStatus
  dueAt                DateTime       @map("due_at")
  budget               Decimal
  currency             Currency       @default(VND)
  budgetInBaseCurrency Decimal        @map("budget_in_base_currency")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  user                 User           @relation(fields: [postedBy], references: [id])
  postedBy             Int            @map("posted_by")
  arrangement          Arrangement    @relation(fields: [arrangementId], references: [id])
  arrangementId        Int            @map("arrangement_id")
  category             Category       @relation(fields: [categoryId], references: [id])
  categoryId           Int            @map("category_id")
  jobApplicants        JobApplicant[]
  jobSkills            JobSkill[]

  @@index([postedBy])
  @@index([arrangementId])
  @@index([categoryId])
  @@index([status])
  @@map("job")
}

model JobApplicant {
  id              Int                   @id @default(autoincrement())
  publicId        String                @unique @default(uuid()) @map("public_id")
  job             Job                   @relation(fields: [jobId], references: [id])
  jobId           Int                   @map("job_id")
  applicant       User                  @relation(fields: [applicantId], references: [id])
  applicantId     Int                   @map("applicant_id")
  resume          Resume                @relation(fields: [resumeId], references: [id])
  resumeId        Int                   @map("resume_id")
  /// Nullable during the ingestion rollout; require it once every resume has a parsed version.
  resumeContent   ResumeContent?        @relation(fields: [resumeContentId], references: [id])
  resumeContentId Int?                  @map("resume_content_id")
  /// Immutable job input captured when the applicant submits the application.
  jobSnapshot     Json?                 @map("job_snapshot")
  jobContentHash  String?               @map("job_content_hash") @db.VarChar(64)
  coverLetter     String                @map("cover_letter")
  proposedRate    Decimal               @map("proposed_rate")
  estimatedDay    Int                   @map("estimated_day")
  status          JobApplicantStatus    @default(PENDING)
  appliedAt       DateTime              @default(now()) @map("applied_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  evaluations     ApplicantEvaluation[]

  @@unique([jobId, applicantId])
  @@index([jobId])
  @@index([applicantId])
  @@index([resumeId])
  @@index([resumeContentId])
  @@map("job_applicant")
}

model Skill {
  id        Int        @id @default(autoincrement())
  publicId  String     @unique @default(uuid()) @map("public_id")
  name      String
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  jobSkills JobSkill[]

  @@map("skill")
}

model JobSkill {
  jobId     Int      @map("job_id")
  skillId   Int      @map("skill_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  job       Job      @relation(fields: [jobId], references: [id])
  skill     Skill    @relation(fields: [skillId], references: [id])

  @@id([jobId, skillId])
  @@index([skillId])
  @@map("job_skill")
}

model Arrangement {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  jobs      Job[]

  @@map("arrangement")
}

model Category {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique @default(uuid()) @map("public_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  jobs      Job[]

  @@map("category")
}

model ApplicantEvaluation {
  id                Int              @id @default(autoincrement())
  publicId          String           @unique @default(uuid()) @map("public_id")
  jobApplicant      JobApplicant     @relation(fields: [jobApplicantId], references: [id])
  jobApplicantId    Int              @map("job_applicant_id")
  status            EvaluationStatus @default(PENDING)
  overallScore      Int?             @map("overall_score")
  scoreBreakdown    Json?            @map("score_breakdown")
  evidence          Json?
  resumeContentHash String           @map("resume_content_hash") @db.VarChar(64)
  jobContentHash    String           @map("job_content_hash") @db.VarChar(64)
  parserVersion     String           @map("parser_version")
  model             String
  promptVersion     String           @map("prompt_version")
  errorMessage      String?          @map("error_message") @db.Text
  createdAt         DateTime         @default(now()) @map("created_at")
  evaluatedAt       DateTime?        @map("evaluated_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@unique([jobApplicantId, resumeContentHash, jobContentHash, parserVersion, model, promptVersion], map: "applicant_evaluation_input_version_key")
  @@index([jobApplicantId, status])
  @@index([status, createdAt])
  @@map("applicant_evaluation")
}
