enum UserType {
  COMPANY
  APPLICANT

  @@map("user_type")
}

enum FileType {
  PDF
  DOCX

  @@map("file_type")
}

enum JobStatus {
  OPEN
  CLOSED

  @@map("job_status")
}

enum JobApplicantStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED

  @@map("job_applicant_status")
}

enum UserRole {
  ROLE_COMPANY
  ROLE_APPLICANT

  @@map("user_role")
}
