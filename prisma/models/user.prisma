model User {
  id             Int      @id @default(autoincrement())
  publicId       String   @unique @default(uuid())
  email          String   @unique
  username       String
  fullName       String
  passwordHashed String
  phoneNumber    String?
  userType       UserType
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  resumes       Resume[]
  refreshTokens RefreshToken[]
  jobApplications JobApplication[]
}

model ApplicantProfile {
  id            Int      @id @default(autoincrement())
  publicId      String   @unique @default(uuid())
  description   String?
  avatarUrl     String?
  location      String?
  user         User     @relation(fields: [userId], references: [id])
  userId        Int
  skills        String
  experienceYears    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model CompanyProfile {
  id            Int      @id @default(autoincrement())
  publicId      String   @unique @default(uuid())
  companyName          String
  description   String?
  avatarUrl     String?
  location      String?
  website      String?
  industry      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
  userId        Int

  @@index([userId])
}
